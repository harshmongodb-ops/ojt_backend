PORT=5000

# Normal network (no restrictive proxy) - used by `npm run dev`
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority

# Restricted network (school/office proxy) - used by `npm run dev:proxy`
# Get the non-SRV connection string from Atlas (toggle off "SRV Connection String"),
# then append &proxyHost=127.0.0.1&proxyPort=1080
MONGODB_URI_PROXY=mongodb://<username>:<password>@<host1>:27017,<host2>:27017,<host3>:27017/<database-name>?ssl=true&replicaSet=<replica-set-name>&authSource=admin&retryWrites=true&w=majority&proxyHost=127.0.0.1&proxyPort=1080
